# ─────────────────────────────────────────────────────────────
#  Etech LMS Backend — Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── AI Service (Anthropic) ────────────────────────────────────
# Required. Format: starts with "sk-"
ANTHROPIC_API_KEY=sk-your_anthropic_api_key_here

# Optional: Custom base URL (e.g. for proxy routers like agentrouter.org)
# Defaults to https://api.anthropic.com if not set.
# ANTHROPIC_BASE_URL=https://agentrouter.org

# Optional: Custom model (defaults to claude-3-5-sonnet-20241022 if not set)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022



# ── Database (MongoDB) ────────────────────────────────────────
# Required. Free cluster at: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/etech

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/etech

# ── Auth (JWT) ────────────────────────────────────────────────
# Required. Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET and JWT_REFRESH_SECRET must be different values.

JWT_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string

# Optional: token expiry durations (defaults shown)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# Optional. If omitted, all origins are allowed.
# Set to your frontend URL in production.
# ALLOWED_ORIGIN=https://etech.yourdomain.com
